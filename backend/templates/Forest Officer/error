<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirm Delete User Report</title>
</head>
<body>
    <h1>Confirm Delete User Report</h1>

    <p>Are you sure you want to delete the report for "{{ report.animal }}" from {{ report.date }}?</p>

    <form method="post">
        {% csrf_token %}
        <button type="submit">Yes, Delete</button>
        <a href="{% url 'forest_officer_view_user_report' %}">Cancel</a>
    </form>
</body>
</html>